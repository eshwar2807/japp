# Copy to .env and fill in. .env is gitignored.

# --- LLM ---
# Omit to let the SDK resolve credentials from an `ant auth login` profile.
ANTHROPIC_API_KEY=
JP_LLM_MODEL=claude-opus-5
JP_LLM_EFFORT=high              # low | medium | high | xhigh | max

# --- Vault ---
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# If unset, a key is generated at data/vault.key (chmod 600) on first run.
JP_ENCRYPTION_KEY=

# --- ATS targets ---
JP_TARGET_MATCH_SCORE=80
JP_MAX_TAILOR_ITERATIONS=3

# --- Browser ---
JP_HEADLESS=false               # spec requires headed mode for the apply flow
JP_PROXY_SERVER=

# --- Safety gates. Leave these true. ---
JP_CONFIRM_SUBMIT=true
JP_CONFIRM_REGISTER=true
